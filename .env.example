# Standalone local mode. Placeholders only; never commit real credentials.
MCP_TRANSPORT=stdio
INGESTION_MODE=polling
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_APPROVED_BOT_TOKEN
# Replace <tg_channel_id> with a real numeric Telegram chat ID.
ALLOWED_CHAT_IDS=<tg_channel_id>
# Use an absolute path when launched by an MCP client with a different cwd.
DB_PATH=/ABSOLUTE/PATH/TO/private-data/connector.sqlite
RETENTION_DAYS=7
ENABLE_SEND=false
SEND_CHAT_IDS=
ENABLE_EVENTS=false

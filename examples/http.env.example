# One standalone process, multiple local MCP clients. No adapter required.
MCP_TRANSPORT=http
INGESTION_MODE=polling
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_APPROVED_BOT_TOKEN
# Replace <tg_channel_id> with a real numeric Telegram chat ID.
ALLOWED_CHAT_IDS=<tg_channel_id>
DB_PATH=/ABSOLUTE/PATH/TO/private-data/connector.sqlite
PORT=8787
MCP_TOKEN=REPLACE_WITH_A_RANDOM_READ_TOKEN_AT_LEAST_32_CHARACTERS
ENABLE_SEND=false
MCP_SEND_TOKEN=
SEND_CHAT_IDS=
ENABLE_EVENTS=false
CALLBACK_HOSTS=
RETENTION_DAYS=7

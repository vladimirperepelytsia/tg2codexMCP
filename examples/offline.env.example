# No Telegram calls: inspect already retained data or an empty local database.
MCP_TRANSPORT=stdio
INGESTION_MODE=offline
# Replace <tg_channel_id> with a real numeric Telegram chat ID.
ALLOWED_CHAT_IDS=<tg_channel_id>
DB_PATH=/ABSOLUTE/PATH/TO/private-data/offline.sqlite
ENABLE_SEND=false
ENABLE_EVENTS=false
